# Copy this file to `.env` and fill in ONE provider's key. `.env` is git-ignored.
# The provider is auto-detected from whichever key you set.

# Option A — Google Gemini (has a free tier, no credit card):
#   get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Option B — OpenAI:
OPENAI_API_KEY=

# Optional: force a provider instead of auto-detecting ("google" or "openai")
# LLM_PROVIDER=google

# Optional overrides (sensible defaults are picked per provider)
# CHAT_MODEL=
# EMBEDDING_MODEL=
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=4
# MIN_RELEVANCE=0.20
# COLLECTION_NAME=financial_docs
