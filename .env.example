# Copy this file to `.env` and fill in your key.  `.env` is git-ignored.

# Required: OpenAI key used for both embeddings and the chat model.
OPENAI_API_KEY=sk-...

# Optional overrides (sensible defaults are baked into src/config.py)
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=4
# MIN_RELEVANCE=0.20
# COLLECTION_NAME=financial_docs
